{
  "uid": "berlin-events-pipeline-health",
  "title": "Pipeline Health",
  "tags": ["berlin-events", "pipeline"],
  "timezone": "Europe/Berlin",
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "style": "dark",
  "graphTooltip": 1,
  "refresh": "10m",
  "time": {"from": "now-60d", "to": "now+120d"},
  "timepicker": {"refresh_intervals": ["5m", "10m", "30m", "1h", "6h", "12h", "1d"]},
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total Events",
      "description": "All events in the catalogue.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#3D71D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS total_events FROM events"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Upcoming Events",
      "description": "Events dated today or later.",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#73BF69"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#73BF69", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS upcoming_events FROM events WHERE datum >= (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Locations",
      "description": "Distinct venues in the catalogue.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#3D71D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS locations FROM locations"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Geocoded Locations",
      "description": "Share of locations with coordinates. Green above 98%.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 98}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "background_solid", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE lat IS NOT NULL AND lon IS NOT NULL) / NULLIF(count(*), 0), 2) AS geocoded_percent FROM locations"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Missing Coordinates",
      "description": "Locations still lacking coordinates. Red when any remain.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 25}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS missing_coordinates FROM locations WHERE lat IS NULL OR lon IS NULL"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Known Future Horizon",
      "description": "Latest event date currently in the catalogue.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "time:YYYY-MM-DD", "color": {"mode": "fixed", "fixedColor": "#B877D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#B877D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(max(datum), (now() AT TIME ZONE 'Europe/Berlin')::date) AS latest_event_date FROM events"}]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Coverage & Sources",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event Date Coverage",
      "description": "Events per calendar day around the present.",
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 70, "gradientMode": "opacity", "spanNulls": false, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "time_series", "rawSql": "SELECT datum::timestamp AS time, 'events' AS metric, count(*) AS value FROM events WHERE datum >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '60 days' GROUP BY datum ORDER BY datum"}]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Source Future Coverage Days",
      "description": "How far ahead each source has events scheduled.",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "d", "color": {"mode": "continuous-GrYlRd"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "days_ahead", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(source, 'unknown') AS source, GREATEST(max(datum) - (now() AT TIME ZONE 'Europe/Berlin')::date, 0) AS days_ahead FROM events GROUP BY 1 ORDER BY days_ahead DESC LIMIT 12"}]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Geocoding Coverage",
      "description": "Locations with and without coordinates.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "has coordinates"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}, {"matcher": {"id": "byName", "options": "missing coordinates"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT CASE WHEN lat IS NULL OR lon IS NULL THEN 'missing coordinates' ELSE 'has coordinates' END AS status, count(*) AS locations FROM locations GROUP BY 1 ORDER BY locations DESC"}]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Events Missing Coordinates by Source",
      "description": "Upcoming events whose venue lacks coordinates, by source.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-YlRd"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "events", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(e.source, 'unknown') AS source, count(*) AS events FROM events e JOIN locations l ON l.id = e.location_id WHERE e.datum >= (now() AT TIME ZONE 'Europe/Berlin')::date AND (l.lat IS NULL OR l.lon IS NULL) GROUP BY 1 ORDER BY events DESC LIMIT 12"}]
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Events with Empty Metadata",
      "description": "Count of events missing key content fields.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-YlRd"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "value", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT label, value FROM (VALUES ('missing title', (SELECT count(*) FROM events WHERE thema IS NULL OR trim(thema) = '')), ('missing category', (SELECT count(*) FROM events WHERE category IS NULL OR trim(category) = '')), ('missing description', (SELECT count(*) FROM events WHERE description IS NULL OR trim(description) = '')), ('missing image', (SELECT count(*) FROM events WHERE image_url IS NULL OR trim(image_url) = ''))) AS metrics(label, value) ORDER BY value DESC"}]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Detail",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Recently Geocoded Locations",
      "description": "Most recently geocoded venues.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "latitude"}, "properties": [{"id": "decimals", "value": 4}, {"id": "custom.align", "value": "right"}]}, {"matcher": {"id": "byName", "options": "longitude"}, "properties": [{"id": "decimals", "value": 4}, {"id": "custom.align", "value": "right"}]}, {"matcher": {"id": "byName", "options": "geocoded_at"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT name AS location, district, lat AS latitude, lon AS longitude, geocoded_at FROM locations ORDER BY geocoded_at DESC NULLS LAST LIMIT 30"}]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Locations Missing Coordinates",
      "description": "Venues awaiting geocoding.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "geocoded_at"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT name AS location, COALESCE(plz, '') AS plz, COALESCE(district, '') AS district, geocoded_at FROM locations WHERE lat IS NULL OR lon IS NULL ORDER BY geocoded_at DESC NULLS LAST, name LIMIT 50"}]
    }
  ]
}
