{
  "uid": "berlin-events-usage-analytics",
  "title": "Usage Analytics",
  "tags": ["berlin-events", "usage"],
  "timezone": "Europe/Berlin",
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "style": "dark",
  "graphTooltip": 1,
  "refresh": "10m",
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {"refresh_intervals": ["5m", "10m", "30m", "1h", "6h", "12h", "1d"]},
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Today at a Glance",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Page Views",
      "description": "Total page hits recorded today.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#3D71D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(sum(page_hits), 0) AS page_views_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique IPs",
      "description": "Distinct client IP hashes seen today.",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#5794F2"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(DISTINCT ip_hash) AS unique_ips_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unique Tokens",
      "description": "Distinct client tokens seen today.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#5794F2"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(DISTINCT token_hash) AS unique_tokens_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Users",
      "description": "Distinct identity rows recorded today.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#3D71D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS unique_users_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Token API Hits",
      "description": "API calls attributed to tokens today.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#73BF69"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#73BF69", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(sum(api_hits), 0) AS token_api_hits_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Event API Hits",
      "description": "Event endpoint calls today.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#73BF69"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#73BF69", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(sum(event_hits), 0) AS event_api_hits_today FROM usage_metrics_identity WHERE day = (now() AT TIME ZONE 'Europe/Berlin')::date"}]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Trends & Distribution",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Unique Audience Over Time",
      "description": "Distinct IPs, tokens and users per day over the last 30 days.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "spanNulls": false, "showPoints": "auto", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "time_series", "rawSql": "SELECT day::timestamp AS time, metric, value FROM (SELECT day, 'unique_ips' AS metric, count(DISTINCT ip_hash)::bigint AS value FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' GROUP BY day UNION ALL SELECT day, 'unique_tokens' AS metric, count(DISTINCT token_hash)::bigint AS value FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' GROUP BY day UNION ALL SELECT day, 'unique_users' AS metric, count(*)::bigint AS value FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' GROUP BY day) s ORDER BY time, metric"}]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Token Usage by Action",
      "description": "Total token-driven hits by action over 30 days.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-BlPu"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "hits", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT label, hits FROM (VALUES ('page views', (SELECT COALESCE(sum(page_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days')), ('day api', (SELECT COALESCE(sum(api_hits - event_hits - verify_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days')), ('event detail', (SELECT COALESCE(sum(detail_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days')), ('event search', (SELECT COALESCE(sum(search_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days')), ('nearby', (SELECT COALESCE(sum(nearby_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days')), ('verify', (SELECT COALESCE(sum(verify_hits), 0) FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days'))) AS metrics(label, hits) ORDER BY hits DESC"}]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API Hits by Endpoint",
      "description": "Daily request volume per endpoint over 30 days.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 15},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "spanNulls": false, "showPoints": "auto", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "time_series", "rawSql": "SELECT day::timestamp AS time, endpoint AS metric, hits AS value FROM usage_metrics_api WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' ORDER BY day, endpoint"}]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Hits by Endpoint",
      "description": "Total hits per endpoint over 30 days.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 15},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-BlPu"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "hits", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT endpoint, sum(hits) AS hits FROM usage_metrics_api WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' GROUP BY endpoint ORDER BY hits DESC"}]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Detail",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Most Active Token Hashes",
      "description": "Top tokens by API activity over 30 days.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 25},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "api_hits"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient", "valueDisplayMode": "text"}}, {"id": "custom.align", "value": "left"}, {"id": "color", "value": {"mode": "continuous-BlPu"}}]}, {"matcher": {"id": "byName", "options": "page_hits"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}}, {"id": "custom.align", "value": "right"}, {"id": "color", "value": {"mode": "continuous-GrYlRd"}}]}, {"matcher": {"id": "byName", "options": "event_hits"}, "properties": [{"id": "custom.align", "value": "right"}]}, {"matcher": {"id": "byName", "options": "ip_count"}, "properties": [{"id": "custom.align", "value": "right"}]}, {"matcher": {"id": "byName", "options": "last_seen"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT left(token_hash, 12) AS token_hash, count(DISTINCT ip_hash) AS ip_count, sum(page_hits) AS page_hits, sum(api_hits) AS api_hits, sum(event_hits) AS event_hits, max(last_seen) AS last_seen FROM usage_metrics_identity WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' GROUP BY token_hash ORDER BY api_hits DESC, page_hits DESC LIMIT 50"}]
    },
    {
      "id": 12,
      "type": "table",
      "title": "HTTP Status and Latency",
      "description": "Recent status codes, request counts and average latency.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 25},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "status"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}}, {"id": "custom.align", "value": "center"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "orange", "value": 400}, {"color": "red", "value": 500}]}}]}, {"matcher": {"id": "byName", "options": "hits"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient", "valueDisplayMode": "text"}}, {"id": "color", "value": {"mode": "continuous-BlPu"}}]}, {"matcher": {"id": "byName", "options": "avg_ms"}, "properties": [{"id": "unit", "value": "ms"}, {"id": "custom.align", "value": "right"}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}, {"id": "color", "value": {"mode": "thresholds"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 200}, {"color": "red", "value": 500}]}}]}, {"matcher": {"id": "byName", "options": "day"}, "properties": [{"id": "unit", "value": "time:YYYY-MM-DD"}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT day, endpoint, status, hits, round(total_ms::numeric / NULLIF(hits, 0), 1) AS avg_ms FROM usage_metrics_http WHERE day >= (now() AT TIME ZONE 'Europe/Berlin')::date - INTERVAL '30 days' ORDER BY day DESC, hits DESC LIMIT 100"}]
    }
  ]
}
