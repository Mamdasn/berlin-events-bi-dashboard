{
  "uid": "berlin-events-editorial-activity",
  "title": "Editorial Activity",
  "tags": ["berlin-events", "editorial"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "style": "dark",
  "graphTooltip": 1,
  "refresh": "10m",
  "time": {"from": "now-90d", "to": "now"},
