  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Current Picks",
      "description": "Total editor's-choice selections on record.",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#3D71D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS current_picks FROM editors_choice"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Upcoming Picks",
      "description": "Selections for events dated today or later.",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#73BF69"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#73BF69", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS upcoming_picks FROM editors_choice ec JOIN events e ON e.id = ec.event_id WHERE e.datum >= CURRENT_DATE"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Picks for Past Events",
      "description": "Selections whose event has already passed.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS past_picks FROM editors_choice ec JOIN events e ON e.id = ec.event_id WHERE e.datum < CURRENT_DATE"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Editors",
      "description": "Distinct people making selections.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#B877D9"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "#B877D9", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "wideLayout": true, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT count(DISTINCT COALESCE(selected_by, 'unknown')) AS editors FROM editors_choice"}]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Trends & Breakdown",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Current Picks by Selection Day",
      "description": "Selections made per day over the last 90 days.",
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "fixed", "fixedColor": "#3D71D9"}, "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 70, "gradientMode": "opacity", "spanNulls": false, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "time_series", "rawSql": "SELECT date_trunc('day', selected_at) AS time, 'picks' AS metric, count(*) AS value FROM editors_choice WHERE selected_at >= now() - INTERVAL '90 days' GROUP BY 1 ORDER BY 1"}]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Picks by Editor",
      "description": "Selection volume per editor.",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 6},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-BlPu"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "picks", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(selected_by, 'unknown') AS selected_by, count(*) AS picks FROM editors_choice GROUP BY 1 ORDER BY picks DESC"}]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Picks by District",
      "description": "Where picked events take place.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-BlPu"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "picks", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(l.district, 'unknown') AS district, count(*) AS picks FROM editors_choice ec JOIN events e ON e.id = ec.event_id JOIN locations l ON l.id = e.location_id GROUP BY 1 ORDER BY picks DESC LIMIT 12"}]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Picks by Category",
      "description": "Content categories of picked events.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "continuous-BlPu"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "colorByField": "picks", "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT COALESCE(NULLIF(trim(e.category), ''), 'uncategorized') AS category, count(*) AS picks FROM editors_choice ec JOIN events e ON e.id = ec.event_id GROUP BY 1 ORDER BY picks DESC LIMIT 12"}]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Picked Events by Event Day",
      "description": "Upcoming picked events grouped by event date.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "#73BF69"}, "custom": {"lineWidth": 1, "fillOpacity": 80, "gradientMode": "none", "axisPlacement": "auto", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"orientation": "vertical", "xTickLabelRotation": -45, "xTickLabelSpacing": 0, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.9, "barRadius": 0, "fullHighlight": false, "tooltip": {"mode": "single", "sort": "none"}, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT e.datum, count(*) AS picks FROM editors_choice ec JOIN events e ON e.id = ec.event_id WHERE e.datum >= CURRENT_DATE GROUP BY e.datum ORDER BY e.datum LIMIT 20"}]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Detail",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Current Picks",
      "description": "All selections, upcoming first.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 23},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "selected_at"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}, {"matcher": {"id": "byName", "options": "datum"}, "properties": [{"id": "unit", "value": "time:YYYY-MM-DD"}]}, {"matcher": {"id": "byName", "options": "title"}, "properties": [{"id": "custom.width", "value": 260}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT ec.selected_at, ec.selected_by, e.datum, e.von, e.thema AS title, l.name AS location, COALESCE(l.district, '') AS district, ec.note FROM editors_choice ec JOIN events e ON e.id = ec.event_id JOIN locations l ON l.id = e.location_id ORDER BY e.datum >= CURRENT_DATE DESC, e.datum, e.von LIMIT 60"}]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Upcoming Pick Coverage by Day",
      "description": "Share of each day's events that have been picked.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 23},
      "datasource": {"type": "postgres", "uid": "berlin-events-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "datum"}, "properties": [{"id": "unit", "value": "time:YYYY-MM-DD"}]}, {"matcher": {"id": "byName", "options": "pick_coverage_percent"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}}, {"id": "custom.align", "value": "right"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 25}, {"color": "green", "value": 60}]}}]}, {"matcher": {"id": "byName", "options": "events"}, "properties": [{"id": "custom.align", "value": "right"}]}, {"matcher": {"id": "byName", "options": "picked_events"}, "properties": [{"id": "custom.align", "value": "right"}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "countRows": false, "fields": "", "reducer": ["sum"]}},
      "targets": [{"refId": "A", "rawQuery": true, "format": "table", "rawSql": "SELECT e.datum, count(*) AS events, count(ec.event_id) AS picked_events, round(100.0 * count(ec.event_id) / NULLIF(count(*), 0), 2) AS pick_coverage_percent FROM events e LEFT JOIN editors_choice ec ON ec.event_id = e.id WHERE e.datum >= CURRENT_DATE AND e.datum < CURRENT_DATE + INTERVAL '30 days' GROUP BY e.datum ORDER BY e.datum LIMIT 30"}]
    }
  ]
}
